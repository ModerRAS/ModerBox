<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ModerBox.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ModerBox.Views.UserControls.FeatureHost"
             x:DataType="vm:FeatureHostViewModel">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="20,16,20,8">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="返回" Command="{Binding Back}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Breadcrumb}" VerticalAlignment="Center" FontSize="18"/>
            </StackPanel>
        </Border>
        <ContentControl Content="{Binding Feature}"/>
    </DockPanel>
</UserControl>
